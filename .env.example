# Provider API keys — at least one must be set, otherwise the app refuses to start.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Logging
LOG_LEVEL=INFO

# Routing
DEFAULT_STRATEGY=latency

# Health monitor — interval between liveness probes
HEALTH_CHECK_INTERVAL_S=10

# Circuit breaker — opens after N consecutive failures, stays open for T seconds.
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_S=30

# HTTP client
REQUEST_TIMEOUT_S=30
CONNECT_TIMEOUT_S=5
